    DECLARE EXIT HANDLER FOR 1452 SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'El rol indicado no existe';
    UPDATE usuarios SET nombre = TRIM(p_nombre), correo = LOWER(TRIM(p_correo)), id_rol = p_id_rol
     WHERE id_usuario = p_id;
END$$

