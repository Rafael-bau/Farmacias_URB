-- Ventas de prueba: se registran con el procedimiento real (prueban triggers, puntos y cancelación)
DELIMITER $$

DROP PROCEDURE IF EXISTS sp_seed_ventas_prueba$$
CREATE PROCEDURE sp_seed_ventas_prueba()
BEGIN
    DECLARE v_caj1, v_caj2, v_cli1, v_cli2, v_cli3, v_cancelar INT;
    DECLARE l_par, l_ibu, l_lor, l_ome, l_amx2, l_met, l_alc, l_vtc2 INT;

    IF (SELECT COUNT(*) FROM ventas) > 0 THEN
        SELECT 'Ya existen ventas: se omite la carga de ventas de prueba' AS aviso;
    ELSE
        SELECT id_usuario INTO v_caj1 FROM usuarios WHERE correo = 'cajero1@farmaciasurb.com';
        SELECT id_usuario INTO v_caj2 FROM usuarios WHERE correo = 'cajero2@farmaciasurb.com';
        SELECT id_cliente INTO v_cli1 FROM clientes WHERE telefono = '5512345601';
        SELECT id_cliente INTO v_cli2 FROM clientes WHERE telefono = '5512345602';
        SELECT id_cliente INTO v_cli3 FROM clientes WHERE telefono = '5512345603';

        SELECT id_lote INTO l_par  FROM lotes WHERE num_lote = 'L-PAR-2501';
        SELECT id_lote INTO l_ibu  FROM lotes WHERE num_lote = 'L-IBU-2501';
        SELECT id_lote INTO l_lor  FROM lotes WHERE num_lote = 'L-LOR-2501';
        SELECT id_lote INTO l_ome  FROM lotes WHERE num_lote = 'L-OME-2501';
        SELECT id_lote INTO l_amx2 FROM lotes WHERE num_lote = 'L-AMX-2502';
        SELECT id_lote INTO l_met  FROM lotes WHERE num_lote = 'L-MET-2501';
        SELECT id_lote INTO l_alc  FROM lotes WHERE num_lote = 'L-ALC-2501';
        SELECT id_lote INTO l_vtc2 FROM lotes WHERE num_lote = 'L-VTC-2502';

        -- V1: efectivo, cliente con puntos, IVA 0%  -> total 213.50
        CALL sp_registrar_venta(v_caj1, v_cli1, 'EFECTIVO', 0.00, JSON_ARRAY(
            JSON_OBJECT('id_lote', l_par, 'cantidad', 2),
            JSON_OBJECT('id_lote', l_ibu, 'cantidad', 1)));

        -- V2: tarjeta, mostrador (sin cliente) -> total 274.00
        CALL sp_registrar_venta(v_caj1, NULL, 'TARJETA', 0.00, JSON_ARRAY(
            JSON_OBJECT('id_lote', l_lor, 'cantidad', 1),
            JSON_OBJECT('id_lote', l_ome, 'cantidad', 2)));

        -- V3: con IVA 16% (cuidado personal / suplementos) -> total 237.80
        CALL sp_registrar_venta(v_caj2, v_cli2, 'TARJETA', 0.16, JSON_ARRAY(
            JSON_OBJECT('id_lote', l_alc,  'cantidad', 2),
            JSON_OBJECT('id_lote', l_vtc2, 'cantidad', 1)));

        -- V4: transferencia -> total 301.00
        CALL sp_registrar_venta(v_caj2, v_cli3, 'TRANSFERENCIA', 0.00, JSON_ARRAY(
            JSON_OBJECT('id_lote', l_amx2, 'cantidad', 1),
            JSON_OBJECT('id_lote', l_met,  'cantidad', 1)));

        -- V5: se registra y se cancela (stock y puntos deben regresar)
        CALL sp_registrar_venta(v_caj1, v_cli1, 'EFECTIVO', 0.00, JSON_ARRAY(
            JSON_OBJECT('id_lote', l_par, 'cantidad', 5)));
        SELECT MAX(id_venta) INTO v_cancelar FROM ventas;
        CALL sp_cancelar_venta(v_cancelar);
    END IF;
END$$

DELIMITER ;

CALL sp_seed_ventas_prueba();
DROP PROCEDURE IF EXISTS sp_seed_ventas_prueba;

